{
  "name": "pi-handoff-ng",
  "version": "0.2.0",
  "description": "Handoff for pi: the current agent writes a handoff document (focus derived from what's outstanding in the conversation), stored outside the project, then a new pi session starts initialized with it — or read an existing handoff into the current session.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "handoff", "extension", "session"],
  "files": [
    "index.ts",
    "utils.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "handoff.config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
